{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimSchema",
  "description": "Schema de validação de claim ativo para casos de uso do DevTasks",
  "type": "object",
  "properties": {
    "slice": {
      "type": "string",
      "pattern": "^UC-\\d{2}\\.\\d{2}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "released", "expired"]
    }
  },
  "required": ["slice", "owner", "claimed_at", "expires_at", "status"]
}
